# ============================================================
# ReliefSync backend configuration
# Copy this file to ".env" in the same folder, then edit it.
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ============================================================

# --- Database (MySQL / MariaDB) ---
# XAMPP defaults: host localhost, user root, EMPTY password, port 3306.
DB_HOST=localhost
DB_USER=root
# Change this ONLY if your MySQL root user has a password.
DB_PASSWORD=
# Must match the database created by database/reliefsync.sql
DB_NAME=reliefsync
DB_PORT=3306

# --- API server ---
# The frontend expects the API on port 5000. Change only if 5000 is busy
# (then also update frontend/vite.config.js and frontend/.env).
PORT=5000

# --- Security ---
# Secret used to sign login tokens. Replace with any long random text.
JWT_SECRET=change-this-to-a-long-random-secret
