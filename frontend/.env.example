# ============================================================
# ReliefSync frontend configuration (optional)
# Copy this file to ".env" only if you need to change the API address.
#
# During development (npm run dev) you do NOT need this file:
# Vite forwards every /api request to http://localhost:5000.
#
# VITE_API_BASE_URL is used by the production build (npm run build).
# Change it if the backend runs on another host or port.
# ============================================================
VITE_API_BASE_URL=http://localhost:5000/api
